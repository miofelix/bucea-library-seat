[Unit]
Description=Serve cached BUCEA updates over HTTP
After=network.target

[Service]
Type=simple
DynamicUser=true
User=bucea-updates-http
Environment=UPDATE_LISTEN=0.0.0.0
Environment=UPDATE_PORT=9080
EnvironmentFile=-/etc/bucea-updates-http.env
ExecStart=/usr/bin/python3 /opt/bucea-library/tools/update_server.py --root /var/lib/bucea-updates/public --listen ${UPDATE_LISTEN} --port ${UPDATE_PORT}
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=-/var/lib/bucea-updates/public
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
