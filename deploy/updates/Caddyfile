# The existing Cloudflare Tunnel maps /updates/* on the public hostname to this
# loopback HTTP origin. Merge these handles into an existing site if necessary.
http://:9080 {
	bind 127.0.0.1
	root * /var/lib/bucea-updates/public

	@manifest path /updates/latest.json
	handle @manifest {
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		header Content-Type "application/json; charset=utf-8"
		@unavailable not file {path}
		respond @unavailable "{\"error\":\"updates temporarily unavailable\"}" 503
		file_server
	}

	@apk path_regexp apk ^/updates/apks/[1-9][0-9]*\.apk$
	handle @apk {
		@cached file {path}
		header @cached Cache-Control "public, max-age=604800, immutable"
		@missing not file {path}
		header @missing Cache-Control "no-store"
		header Content-Type "application/vnd.android.package-archive"
		file_server
	}
	handle {
		respond 404
	}
}
